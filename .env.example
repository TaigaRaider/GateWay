# GateWay — environment variables
# Copy to .env.local and fill in what you need. Never commit real secrets.

# Canonical site URL used by metadata, sitemap.xml and robots.txt (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: enables direct email delivery from the contact form.
# Without it, the form gracefully falls back to opening the visitor's mail app.
RESEND_API_KEY=

# Where contact enquiries are delivered.
CONTACT_TO=adetunji.timothy@gmail.com

# A verified sender address in Resend.
CONTACT_FROM="Portfolio <onboarding@resend.dev>"
